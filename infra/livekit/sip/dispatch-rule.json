{
  "dispatch_rule": {
    "name": "callgo-rule-${LK_NUMBER}",
    "metadata": "{\"source\":\"lk-setup\",\"number\":\"${LK_NUMBER}\",\"sipNumberId\":\"${LK_SIP_NUMBER_ID}\"}",
    "trunk_ids": ["${LK_INBOUND_TRUNK_ID}"],
    "rule": {
      "dispatch_rule_individual": {
        "room_prefix": "${LK_ROOM_PREFIX}"
      }
    },
    "attributes": {
      "callgo.direction": "inbound",
      "callgo.sipNumberId": "${LK_SIP_NUMBER_ID}"
    },
    "room_config": {
      "departure_timeout": 10,
      "agents": [
        {
          "agent_name": "${LK_AGENT_NAME}",
          "metadata": "{\"sipNumberId\":\"${LK_SIP_NUMBER_ID}\",\"direction\":\"inbound\"}"
        }
      ]
    }
  }
}
