# CallGo.mn backend configuration. Copy to .env for local development.
# Real environment variables always win over values in .env.

# --- Core --------------------------------------------------------------------
# dev | prod (prod enforces real secrets)
CALLGO_ENV=dev
CALLGO_HTTP_ADDR=:8080
CALLGO_DATABASE_URL=postgres://callgo:callgo@localhost:5432/callgo?sslmode=disable
CALLGO_CORS_ORIGINS=http://localhost:5173
# trace|debug|info|warn|error
CALLGO_LOG_LEVEL=info
# console output; defaults to false in prod
CALLGO_LOG_PRETTY=true
CALLGO_SHUTDOWN_TIMEOUT=15s

# --- Secrets (REQUIRED in prod) ----------------------------------------------
# Generate each with: openssl rand -base64 32
CALLGO_JWT_SECRET=dev-secret-change-me
# Shared with the Python agent worker (X-Agent-Token header).
CALLGO_AGENT_TOKEN=dev-agent-token
# Base64 of exactly 32 bytes; encrypts LLM API keys at rest.
# If empty, a key is derived from CALLGO_JWT_SECRET (dev only).
CALLGO_ENCRYPTION_KEY=

# --- Bootstrap admin / signup ------------------------------------------------
CALLGO_ADMIN_EMAIL=admin@callgo.mn
CALLGO_ADMIN_PASSWORD=admin1234
CALLGO_ALLOW_SIGNUP=false

# --- Local development helpers -----------------------------------------------
# simulate ringing/answer without a trunk
CALLGO_MOCK_TELEPHONY=true
# generate fake calls for the Live Desk
CALLGO_SIMULATOR=false
CALLGO_SIMULATOR_INTERVAL=4s

# --- LiveKit -----------------------------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=callgo
# Webhook verification key pair; defaults to the API key pair above.
#LIVEKIT_WEBHOOK_API_KEY=
#LIVEKIT_WEBHOOK_API_SECRET=

# --- SIP (LiveKit SIP <-> Asterisk) ------------------------------------------
SIP_ASTERISK_HOST=localhost
SIP_ASTERISK_PORT=5060
# comma-separated IPs/CIDRs allowed to send INVITEs
SIP_ALLOWED_ADDRESSES=
# udp | tcp | tls
SIP_TRANSPORT=udp
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
SIP_RING_TIMEOUT=30s
SIP_MAX_CALL_DURATION=20m

# --- Campaign dialer ---------------------------------------------------------
CALLGO_CAMPAIGN_POLL_INTERVAL=2s
CALLGO_CAMPAIGN_RETRY_BACKOFF=5m
CALLGO_CAMPAIGN_MAX_CONCURRENCY=20

# --- Agent worker (LLM test proxy) -------------------------------------------
CALLGO_AGENT_WORKER_URL=http://localhost:8090
