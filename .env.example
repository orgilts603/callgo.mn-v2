# =============================================================================
# CallGo.mn v2 — environment configuration (орчны тохиргоо)
#
# Copy to .env (or run `make env`, which also generates random secrets):
#     cp .env.example .env
# Read by: docker compose (infra/docker-compose.yml, via --env-file .env),
# `make dev` (infra/scripts/dev.sh exports it to backend/agent/frontend),
# and the infra scripts. Keep one KEY=value per line; comments on their own
# line only (no trailing "# ..." after a value).
#
# Values below are for LOCAL DEVELOPMENT. For production set CALLGO_ENV=prod
# and replace every secret (the backend refuses to start in prod with the
# development defaults). Values marked [compose] are overridden inside the
# containers by infra/docker-compose.yml with container-network addresses.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend core / Үндсэн тохиргоо
# -----------------------------------------------------------------------------
# dev | prod. prod enforces strong secrets and JSON logs.
CALLGO_ENV=dev
# [compose] PostgreSQL DSN used when the backend runs on the host (make dev).
CALLGO_DATABASE_URL=postgres://callgo:callgo@localhost:5432/callgo?sslmode=disable
# Listen address of the HTTP API.
CALLGO_HTTP_ADDR=:8080
# HS256 signing key for user JWTs (>= 32 random chars in prod):
#   openssl rand -hex 32
CALLGO_JWT_SECRET=dev-secret-change-me
# Shared secret the Python agent sends as X-Agent-Token to /internal/agent/*
# (>= 16 random chars in prod). Used by BOTH backend and agent.
CALLGO_AGENT_TOKEN=dev-agent-token
# AES-256-GCM key (32 bytes, base64) encrypting LLM API keys at rest:
#   openssl rand -base64 32
# Empty = derived from CALLGO_JWT_SECRET (dev only; required in prod).
# Changing it later makes stored LLM API keys unreadable — re-enter them.
CALLGO_ENCRYPTION_KEY=
# First admin, created on first start when no user exists (org "CallGo Demo").
CALLGO_ADMIN_EMAIL=admin@callgo.mn
CALLGO_ADMIN_PASSWORD=admin1234
# Allow POST /api/auth/register (self-service org sign-up).
CALLGO_ALLOW_SIGNUP=false
# Comma separated browser origins allowed by CORS (only needed when the UI is
# served from another origin than the API, e.g. the Vite dev server).
CALLGO_CORS_ORIGINS=http://localhost:5173
# debug | info | warn | error (backend and agent).
CALLGO_LOG_LEVEL=info
# Human-readable console logs (default true in dev, false in prod).
CALLGO_LOG_PRETTY=true
# Graceful shutdown budget.
CALLGO_SHUTDOWN_TIMEOUT=15s

# -----------------------------------------------------------------------------
# Telephony mode / Утасны горим
# -----------------------------------------------------------------------------
# true = no LiveKit SIP calls at all (mock ringing/answer/hangup). Set false
# for real calls (infra/scripts/full-up.sh forces false).
CALLGO_MOCK_TELEPHONY=true
# Generate fake calls + transcripts for demoing the Live Desk.
CALLGO_SIMULATOR=false
# Dev only: deterministic offline embeddings for knowledge bases without an embeddings API
CALLGO_EMBED_FAKE=false
CALLGO_SIMULATOR_INTERVAL=4s
# [compose] Agent worker HTTP API (LLM "Test" button proxy).
CALLGO_AGENT_WORKER_URL=http://localhost:8090

# -----------------------------------------------------------------------------
# Outbound campaign dialer / Кампанит ажлын залгагч
# -----------------------------------------------------------------------------
CALLGO_CAMPAIGN_POLL_INTERVAL=2s
CALLGO_CAMPAIGN_RETRY_BACKOFF=5m
# Global cap of simultaneous campaign calls across all campaigns.
CALLGO_CAMPAIGN_MAX_CONCURRENCY=20

# -----------------------------------------------------------------------------
# LiveKit server / LiveKit сервер
# -----------------------------------------------------------------------------
# [compose] Server URL for backend/agent on the host (ws:// or http://).
LIVEKIT_URL=ws://localhost:7880
# API key + secret shared by livekit-server, livekit-sip, egress, backend,
# agent and the lk CLI. Secret >= 32 chars; use hex (no YAML specials):
#   echo "LIVEKIT_API_SECRET=$(openssl rand -hex 32)"
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-callgo-local-only-change-me-0123456789
# Where livekit-server POSTs webhooks (room/participant/egress events).
# Compose default: the backend container. `make dev` (backend on the host)
# overrides it with http://host.docker.internal:8080/api/livekit/webhook.
LIVEKIT_WEBHOOK_URL=http://backend:8080/api/livekit/webhook
# Optional separate webhook signing pair (defaults to LIVEKIT_API_KEY/SECRET).
LIVEKIT_WEBHOOK_API_KEY=
LIVEKIT_WEBHOOK_API_SECRET=
# Agent name used for explicit dispatch (backend side). Keep in sync with
# CALLGO_AGENT_NAME (agent side).
LIVEKIT_AGENT_NAME=callgo

# -----------------------------------------------------------------------------
# LiveKit SIP <-> Asterisk (backend provisioning + lk-setup.sh)
# LiveKit SIP ба Asterisk хоорондын холболт
# -----------------------------------------------------------------------------
# Asterisk as seen from livekit-sip: outbound trunk address. In the compose
# stack Asterisk has the static IP 172.28.0.10 on callgo-net.
SIP_ASTERISK_HOST=172.28.0.10
SIP_ASTERISK_PORT=5060
# udp | tcp | tls (outbound trunk transport).
SIP_TRANSPORT=udp
# Source IPs/CIDRs livekit-sip accepts INVITEs from (inbound trunk allow-list)
# = Asterisk's address. Comma separated.
SIP_ALLOWED_ADDRESSES=172.28.0.10/32
# Digest credentials livekit-sip presents to Asterisk on outbound calls
# (Asterisk's `livekit` endpoint challenges with them). Required for
# docker compose --profile full.  openssl rand -hex 16
SIP_AUTH_USERNAME=livekit
SIP_AUTH_PASSWORD=change-me-sip-shared-secret
# Ring window for outbound calls, and hard cap per call.
SIP_RING_TIMEOUT=30s
SIP_MAX_CALL_DURATION=20m
# E.164 numbers provisioned by infra/scripts/lk-setup.sh and used as the
# default caller ID by sip-test-call.sh (comma separated). Numbers added in
# the CRM are provisioned by the backend automatically.
SIP_NUMBERS=+97677001234

# -----------------------------------------------------------------------------
# Asterisk / carrier trunk (docker compose --profile full)
# Asterisk ба операторын SIP шугам — see docs/ASTERISK.md
# -----------------------------------------------------------------------------
# Public IPv4 of the VPS, written into SIP/SDP towards the carrier.
# Empty = auto-detected by infra/scripts/full-up.sh.
SIP_EXTERNAL_IP=
# Carrier SBC host (IP or DNS) and port. Empty = no PSTN trunk yet.
CARRIER_HOST=
CARRIER_PORT=5060
# Trunk credentials (empty username = IP-authenticated trunk).
CARRIER_USERNAME=
CARRIER_PASSWORD=
# yes = REGISTER to the carrier (registration trunks); no = IP trunk.
CARRIER_REGISTER=no
# From header user on outbound calls: empty = trunk username; "callerid" =
# send the CallGo number (caller ID) as From user.
CARRIER_FROM_USER=
# From header domain (empty = CARRIER_HOST).
CARRIER_FROM_DOMAIN=
# Carrier signalling source IPs/CIDRs (comma separated). Empty = CARRIER_HOST.
CARRIER_MATCH=
# Where the called DID is read from on inbound calls: ruri | to.
CARRIER_DID_SOURCE=ruri
# E.164 DID used when the carrier only sends the trunk username.
CARRIER_DEFAULT_DID=
# Number format the carrier expects on outbound: e164 | intl | national.
CARRIER_NUMBER_FORMAT=national
# PBX-side MixMonitor recording of every call (yes | no).
ASTERISK_RECORD_CALLS=no
# Enables the "testphone" softphone account (>= 12 chars) for end-to-end tests
# without a carrier; dialling any number from it simulates an inbound call to
# CARRIER_DEFAULT_DID. Leave empty in production.
TEST_PHONE_PASSWORD=

# -----------------------------------------------------------------------------
# Agent worker (Python) / AI агент
# -----------------------------------------------------------------------------
# [compose] Backend base URL for /internal/agent/*.
CALLGO_BACKEND_URL=http://localhost:8080
# Explicit-dispatch agent name the worker registers (= LIVEKIT_AGENT_NAME).
CALLGO_AGENT_NAME=callgo
# Worker HTTP port (/health, /test-llm).
CALLGO_HTTP_PORT=8090
# faster-whisper model id (large-v3, large-v3-turbo, medium, small ...) or a
# local path. `make models` pre-downloads it.
CALLGO_WHISPER_MODEL=large-v3
# cpu | cuda | auto
CALLGO_WHISPER_DEVICE=auto
# int8 (CPU) | float16 (GPU) | auto
CALLGO_WHISPER_COMPUTE_TYPE=auto
# [compose] Piper voices directory (*.onnx + *.onnx.json).
CALLGO_PIPER_VOICES_DIR=./models/piper
# Default Piper voice name (file stem in CALLGO_PIPER_VOICES_DIR). There is no
# public Mongolian Piper voice: put your trained mn_MN voice there, or use a
# cloud TTS in the agent profile.
CALLGO_PIPER_DEFAULT_VOICE=mn_MN-default-medium
# Extra public Piper voices `make models` downloads (space separated).
PIPER_EXTRA_VOICES=kk_KZ-issai-high ru_RU-irina-medium
# BCP-47 language when a profile does not set one.
CALLGO_DEFAULT_LANGUAGE=mn
# Safety cap per call in seconds (profiles may lower it).
CALLGO_MAX_CALL_DURATION_SEC=600
# How often transcript/state events are flushed to the backend (ms).
CALLGO_EVENT_FLUSH_INTERVAL_MS=250
# End-of-turn detection: vad | multilingual (livekit turn-detector model).
CALLGO_TURN_DETECTOR=vad
# Host directory mounted at /models in the agent container (relative paths are
# relative to infra/). Holds hf/ (Hugging Face cache) and piper/.
CALLGO_MODELS_DIR=../agent/models
# Hugging Face cache for faster-whisper / turn-detector weights. Set by the
# agent image (/models/hf) and by `make dev` (agent/models/hf); override only
# for a custom location.
# HF_HOME=./models/hf
# Agent mock-backend harness only (agent/callgo_agent/mock_backend.py): force
# the LLM it hands to the worker, e.g. a local Ollama.
# MOCK_LLM_PROVIDER=openai_compatible
# MOCK_LLM_MODEL=qwen2.5
# MOCK_LLM_BASE_URL=http://localhost:11434/v1
# MOCK_LLM_API_KEY=

# -----------------------------------------------------------------------------
# LLM provider keys (optional defaults). Per-organisation keys entered in the
# CRM (Settings -> LLM) take precedence; these are used when a config has no
# key of its own. LLM нийлүүлэгчийн түлхүүрүүд (заавал биш).
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Frontend. The SPA calls the API with relative /api URLs (nginx proxy in
# production, Vite proxy in dev), so no VITE_* variables are required.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Docker deployment knobs / Docker байршуулалт
# -----------------------------------------------------------------------------
# Image tag for the locally built callgo/* images.
CALLGO_VERSION=dev
# PostgreSQL password of user "callgo" (compose builds the backend DSN from it).
POSTGRES_PASSWORD=callgo
# host:port bindings. Keep internal services on loopback; put Caddy (TLS) in
# front of the frontend in production: FRONTEND_PUBLISH=127.0.0.1:8088
POSTGRES_PUBLISH=127.0.0.1:5432
REDIS_PUBLISH=127.0.0.1:6379
BACKEND_PUBLISH=127.0.0.1:8080
LIVEKIT_HTTP_PUBLISH=127.0.0.1:7880
FRONTEND_PUBLISH=8088
# true = add the LiveKit egress recorder (compose profile "recording") and
# auto-record inbound calls created by lk-setup.sh dispatch rules.
CALLGO_RECORDING=false
# true = use infra/docker-compose.gpu.yml (agent on CUDA).
CALLGO_GPU=false
# Pinned images (override to upgrade).
LIVEKIT_SERVER_IMAGE=livekit/livekit-server:v1.13
LIVEKIT_SIP_IMAGE=livekit/sip:v1.17
LIVEKIT_EGRESS_IMAGE=livekit/egress:v1.14
LIVEKIT_CLI_IMAGE=livekit/livekit-cli:v2.18
ASTERISK_IMAGE=andrius/asterisk:22.10.1_debian-trixie
POSTGRES_IMAGE=pgvector/pgvector:pg16   # Postgres 16 + pgvector (RAG embeddings)
REDIS_IMAGE=redis:7.4-alpine

# Optional digest auth required on the LiveKit inbound trunk (Asterisk must send these)
SIP_INBOUND_AUTH_USERNAME=
SIP_INBOUND_AUTH_PASSWORD=
