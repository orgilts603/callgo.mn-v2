# CallGo.mn agent worker -- copy to agent/.env
# Settings (callgo_agent/config.py) use the CALLGO_ prefix; LiveKit vars are unprefixed.

# --- Go backend (control plane) ---
CALLGO_BACKEND_URL=http://localhost:8080
CALLGO_AGENT_TOKEN=dev-agent-token
# LiveKit explicit-dispatch agent name; must match the dispatch rule the backend creates
CALLGO_AGENT_NAME=callgo
# Worker HTTP server: /health, /test-llm
CALLGO_HTTP_PORT=8090

# --- LiveKit ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Local models ---
CALLGO_WHISPER_MODEL=large-v3          # or a path; try "small" / "medium" on CPU
CALLGO_WHISPER_DEVICE=auto             # cpu | cuda | auto
CALLGO_WHISPER_COMPUTE_TYPE=auto       # int8 | float16 | auto
CALLGO_PIPER_VOICES_DIR=./models/piper
CALLGO_PIPER_DEFAULT_VOICE=mn_MN-default-medium
# HF_HOME=./models/hf                  # where faster-whisper / turn-detector weights are cached

# --- Behaviour ---
CALLGO_DEFAULT_LANGUAGE=mn
CALLGO_MAX_CALL_DURATION_SEC=600
CALLGO_EVENT_FLUSH_INTERVAL_MS=250

# --- Mock backend only (python -m callgo_agent.mock_backend) ---
# The first key found picks the demo LLM: OpenAI > Google > Anthropic > Groq.
# With none set it points at a local Ollama-style server (http://localhost:11434/v1, qwen2.5).
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# MOCK_LLM_PROVIDER=openai_compatible   # force a provider
# MOCK_LLM_MODEL=qwen2.5
# MOCK_LLM_BASE_URL=http://localhost:11434/v1
# MOCK_LLM_API_KEY=

# Turn detection: vad (default) | multilingual
CALLGO_TURN_DETECTOR=vad
CALLGO_LOG_LEVEL=INFO
